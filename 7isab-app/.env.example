# Copy to .env.local and set your computer's LAN IP so a phone can reach the server.
# Start the server with: php artisan serve --host 0.0.0.0 --port 8000
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1

# Optional: over-the-air updates server (the OTA plugin is left out when these are empty).
OTA_SERVER_URL=
OTA_API_KEY=
