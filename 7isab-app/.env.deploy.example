# Production values for release builds and OTA publishing.
#   cp .env.deploy.example .env.deploy
# Used ALONE by `npm run build:deploy:*` and the `ota` / `publish:*` / `promote` scripts:
# .env is not read. Never commit .env.deploy (it holds secrets).
# EXPO_PUBLIC_* and OTA_API_KEY are baked into the app at build time.

# 7isab server.
EXPO_PUBLIC_API_URL=https://abdopr-7isba.duckdns.org/api/v1

# OTACenter: server, the API key of this runtime's version (package com.abdopr.apps.hisab).
OTA_SERVER_URL=https://abdopr-otacenter.duckdns.org
OTA_API_KEY=

# OTACenter API token for publish / promote (npm run ota:login saves it here).
OTA_TOKEN=
