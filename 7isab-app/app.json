{
  "expo": {
    "name": "حساب",
    "slug": "7isab-app",
    "version": "0.1.0",
    "runtimeVersion": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "7isabapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.abdopr.apps.hisab"
    },
    "android": {
      "package": "com.abdopr.apps.hisab",
      "adaptiveIcon": {
        "backgroundColor": "#0A503C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F5C45",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B1512",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "react-native-quick-crypto",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Your profile photo is picked from your photos. It is encrypted on this phone before it is saved or synced.",
          "cameraPermission": "The camera is used to take your profile photo. It is encrypted on this phone before it is saved or synced.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
