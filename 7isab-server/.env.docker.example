# Docker config for the 7isab server (see docker-compose.yml).
#   cp .env.docker.example .env.docker
# Never commit .env.docker.

APP_NAME=7isab
# php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_LEVEL=info

# Database (the shared it-pg-db container on the it-db-net network).
DB_DATABASE=hisab
DB_USERNAME=hisab
DB_PASSWORD=secret

MAIL_MAILER=log

# Real time (Laravel Reverb, community live events). Generate the app id, key
# and secret once, e.g. `php -r "echo bin2hex(random_bytes(16));"`, and keep
# them secret except REVERB_APP_KEY, which the app and the web client use.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where clients connect: the public host, behind the host nginx's TLS.
REVERB_HOST=example.com
REVERB_PORT=443
REVERB_SCHEME=https
# Where Reverb listens inside its container, and its port on the host
# (127.0.0.1 only; the host nginx proxies /app and /apps to it).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001
REVERB_HOST_PORT=8061

# Vite (front-end build). VITE_* values are baked in when the image is built
# (the assets stage of the Dockerfile), not read at runtime.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# The first admin, created by the seeder.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional: where the Quran text is imported from (default: the quran.com API v4).
# QURAN_SOURCE_URL=
